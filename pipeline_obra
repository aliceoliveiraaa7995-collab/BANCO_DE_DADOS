# ============================================================
# PIPELINE SIMPLES: planilha da obra (Pasta5.xlsx) 
# ============================================================

import re
from pathlib import Path

import openpyxl
import pandas as pd

ARQUIVO_EXCEL = "Pasta5.xlsx"
ABA = "Plan1"
PASTA_SAIDA = Path("saida_pipeline_obra")
PASTA_SAIDA.mkdir(exist_ok=True)

# Linha de grupo tem identificação no formato "001-001"
RE_GRUPO = re.compile(r"^\d{3}-\d{3}$")

# A planilha original tem um problema de acentuação onde cada letra
# acentuada foi trocada por outro caractere. Esse mapa converte de
# vokta (ex.: "ADMINISTRA€ÇO" -> "ADMINISTRAÇÃO").
MAPA_ACENTOS = {
    "€": "Ç", "Ç": "Ã", "µ": "Á", "\x90": "É", "Ö": "Í",
    "¶": "Â", "Ò": "Ê", "å": "Õ", "à": "Ó", "é": "Ú",
    "â": "Ô", "ü": "³", "ý": "²", "\x9d": "Ø", "ø": "°",
    "¦": "ª", "ï": "'", "§": "º", "«": '"', "¬": '"', "ž": "x", "æ": "³",
}
TABELA_ACENTOS = str.maketrans(MAPA_ACENTOS)


def corrigir_texto(valor):
    """Corrige a acentuação de uma célula de texto."""
    if not isinstance(valor, str):
        return valor
    texto = valor.translate(TABELA_ACENTOS)
    texto = texto.replace(" · ", " E ")  # "·" era usado no lugar da palavra "E"
    return texto.strip()


def ler_planilha():
    """Lê a Pasta5.xlsx célula por célula"""
    wb = openpyxl.load_workbook(ARQUIVO_EXCEL, data_only=True)
    ws = wb[ABA]

    codigo_obra = str(ws.cell(row=1, column=1).value).replace("codigo de obra", "").strip()
    bdi_servico = ws.cell(row=1, column=8).value

    colunas = ["identificacao", "tipo", "codigo", "descricao", "unidade",
               "quantidade", "valor_sem_bdi", "valor_com_bdi", "parcela"]
    linhas = [[ws.cell(row=r, column=c).value for c in range(1, 10)]
              for r in range(3, ws.max_row + 1)]

    return codigo_obra, bdi_servico, pd.DataFrame(linhas, columns=colunas)


def classificar_linha(row):
    """Diz o que é cada linhs"""
    if isinstance(row["descricao"], str) and row["descricao"].strip().upper().startswith("TOTAL"):
        return "outra"                     # linha de total (TOTAL ETAPA / TOTAL SUB-OBRA)
    if pd.notna(row["tipo"]):
        return "item"                      # linha de serviço (tem TIPO preenchido)
    if isinstance(row["identificacao"], str) and RE_GRUPO.match(row["identificacao"].strip()):
        return "grupo"                     # linha de grupo (ex: "001-001")
    return "outra"                         # cabeçalho de etapa (1, 2, 3...) ou linha vazia


def montar_tabelas(codigo_obra, bdi_servico, df):
    df = df.copy()
    df["linha"] = df.apply(classificar_linha, axis=1)

    # corrige acentuação nas colunas de texto
    for coluna in ["identificacao", "tipo", "descricao", "unidade"]:
        df[coluna] = df[coluna].apply(corrigir_texto)

    # garante que os números sejam números 
    df["codigo"] = pd.to_numeric(df["codigo"], errors="coerce").astype("Int64")
    for coluna in ["quantidade", "valor_sem_bdi", "valor_com_bdi", "parcela"]:
        df[coluna] = pd.to_numeric(df[coluna], errors="coerce")

    obras = pd.DataFrame([{"codigo_obra": codigo_obra, "bdi_servico": bdi_servico}])

    grupos = (df[df["linha"] == "grupo"][["identificacao", "descricao"]]
              .drop_duplicates())

    # cada item pertence ao último grupo visto acima dele na planilha
    df["grupo_do_item"] = df["identificacao"].where(df["linha"] == "grupo").ffill()

    servicos = (df[df["linha"] == "item"]
                [["grupo_do_item", "identificacao", "tipo", "codigo", "descricao",
                  "unidade", "quantidade", "valor_sem_bdi", "valor_com_bdi", "parcela"]]
                .rename(columns={"grupo_do_item": "grupo_identificacao"}))

    return obras, grupos, servicos


def salvar_csv(nome, tabela):
    caminho = PASTA_SAIDA / f"{nome}.csv"
    tabela.to_csv(caminho, index=False, encoding="utf-8")
    print(f"{caminho}  ({len(tabela)} linhas)")


def main():
    codigo_obra, bdi_servico, df = ler_planilha()
    obras, grupos, servicos = montar_tabelas(codigo_obra, bdi_servico, df)

    print("Arquivos gerados:")
    salvar_csv("obras", obras)
    salvar_csv("grupos_servicos", grupos)
    salvar_csv("servicos", servicos)


if __name__ == "__main__":
    main()