DROP TABLE IF EXISTS servicos CASCADE;
DROP TABLE IF EXISTS grupos_servicos CASCADE;
DROP TABLE IF EXISTS obras CASCADE;

CREATE TABLE obras (
    id INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    codigo_obra VARCHAR(20) NOT NULL,
    bdi_servico NUMERIC(10,2)
);

CREATE TABLE grupos_servicos (
    id INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    obra_id INTEGER NOT NULL,
    identificacao VARCHAR(20) NOT NULL,
    descricao VARCHAR(255) NOT NULL,

    CONSTRAINT fk_grupo_obra
        FOREIGN KEY (obra_id)
        REFERENCES obras(id)
);

CREATE TABLE servicos (
    id INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    grupo_id INTEGER NOT NULL,

    identificacao VARCHAR(30) NOT NULL,
    tipo VARCHAR(50),
    codigo INTEGER,
    descricao VARCHAR(500),
    unidade VARCHAR(20),

    quantidade NUMERIC(18,2),
    valor_sem_bdi NUMERIC(18,2),
    valor_com_bdi NUMERIC(18,2),
    parcela NUMERIC(18,2),

    CONSTRAINT fk_servico_grupo
        FOREIGN KEY (grupo_id)
        REFERENCES grupos_servicos(id)
);

